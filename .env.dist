# YANGI .env FAYL YARATING VA QUYIDAGILARNI TO'LDIRING:

# --- Telegram ---
BOT_TOKEN=123456789:AAA...
ADMINS=12345678,87654321

# To'lov cheklari yuboriladigan kanal (bot admin bo'lishi shart)
PAYMENT_CHANNEL_ID=@tahrirchiai

# --- OpenAI ---
# OPENAI_API_KEY yoki OPEN_AI_TOKEN — ikkisidan biri
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OpenAI hisobidagi boshlang'ich byudjet (USD). Statistikada "qoldi" shu asosda. Ixtiyoriy.
OPENAI_BUDGET_USD=0
# Bir vaqtda OpenAI'ga ketadigan so'rovlar (tarifingizga qarab 10-40). Ixtiyoriy.
AI_CONCURRENCY=10

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=tahrirchi

# --- To'lov ---
CARD_NUMBER=9860 1701 0951 8093
CARD_HOLDER=Nodirbek Shukurov
